        "children": ["n1"],
        "message": {
          "id": "n0",
          "author": {
            "role": "user"
          },
          "create_time": 1555093200,
          "content": {
            "content_type": "text",
            "parts": [
              "My sourdough starter smells like nail polish and barely rises. Day 9. What am I doing wrong?"
            ]
          },
          "metadata": {}
        }
      },
      "n1": {
        "id": "n1",
        "parent": "n0",
        "children": ["n2"],
        "message": {
          "id": "n1",
          "author": {
            "role": "assistant"
          },
          "create_time": 1555093240,
          "content": {
            "content_type": "text",
            "parts": [
              "That acetone smell means the starter is hungry. Feed it twice a day at 1:1:1 (starter, flour, water by weight), keep it somewhere around 24–26 °C, and swap a quarter of the flour for whole rye. Rye gives the yeast more to eat."
            ]
          },
          "metadata": {}
        }
      },
      "n2": {
        "id": "n2",
        "parent": "n1",
        "children": ["n3"],
        "message": {
          "id": "n2",
          "author": {
            "role": "user"
          },
          "create_time": 1555093280,
          "content": {
            "content_type": "text",
            "parts": ["My kitchen is cold. Around 18 °C."]
          },
          "metadata": {}
        }
      },
      "n3": {
        "id": "n3",
        "parent": "n2",
        "children": [],
        "message": {
          "id": "n3",
          "author": {
            "role": "assistant"
          },
          "create_time": 1555093320,
          "content": {
            "content_type": "text",
            "parts": [
              "Then use the oven with only the light on, or a spot on top of the fridge. At 18 °C a starter can take two weeks to settle. It is not dead, just slow."
            ]
          },
          "metadata": {}
        }
      }
    }
  },
